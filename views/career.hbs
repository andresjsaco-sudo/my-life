<main id="main" class="wrap narrow">
  <section class="page-head" aria-labelledby="page-title">
    <h1 id="page-title">Career</h1>
    <p class="page-lede">Where I have worked and studied. The full version is in my <a href="{{person.cv}}">CV (PDF)</a>.</p>
  </section>

  <section class="block" aria-labelledby="exp-title">
    <h2 id="exp-title">Experience</h2>
    <ol class="timeline">
      {{#each experience}}
      <li>
        <p class="tl-when">{{period}}, {{place}}</p>
        <h3>{{title}}</h3>
        <p class="tl-role">{{role}}</p>
        <p>{{desc}}</p>
      </li>
      {{/each}}
    </ol>
  </section>

  <section class="block" aria-labelledby="edu-title">
    <h2 id="edu-title">Education</h2>
    <ol class="timeline">
      <li>
        <p class="tl-when">Expected September 2027, Barranquilla</p>
        <h3>B.Sc. in Electronic Engineering, Universidad del Norte</h3>
        <p class="tl-role">Coursework completed December 2026</p>
        <p>Saber Pro, Colombia's national exit exam: 99th percentile. Relevant coursework: Microcontrollers, Telematics, Communications, Antennas and Radio Links, Cellular Systems, Automatic Control, Measurements and Instrumentation.</p>
      </li>
    </ol>
  </section>

  <section class="block" aria-labelledby="lang-title">
    <h2 id="lang-title">Languages</h2>
    <div class="langs-row">{{#each languages}}<span class="lang">{{> flag code=code}}{{k}}</span>{{/each}}</div>
  </section>
</main>
