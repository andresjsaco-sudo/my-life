<header class="topbar">
  <div class="wrap topbar-inner">
    <a href="/" class="brand"{{#if (eq page "home")}} aria-current="page"{{/if}}>
      <svg class="brand-mark" width="28" height="28" viewBox="0 0 32 32" aria-hidden="true"><rect class="mark-bg" x="2" y="2" width="28" height="28" rx="8" /><path class="mark-j" d="M18 9v9.5c0 2.6-1.6 4-3.8 4-2 0-3.2-1.2-3.2-3" /><circle class="mark-dot" cx="23" cy="9" r="2.4" /></svg>
      <span>{{person.name}}</span>
    </a>
    <nav aria-label="Main">
      <ul class="nav">
        <li><a href="/projects"{{#if (eq page "projects")}} aria-current="page"{{/if}}>Projects</a></li>
        <li><a href="/career"{{#if (eq page "career")}} aria-current="page"{{/if}}>Career</a></li>
        <li><a href="#contact">Contact</a></li>
        <li class="nav-wide"><a href="{{person.cv}}" class="nav-cv">CV.pdf</a></li>
        <li>
          <button type="button" class="theme-btn" id="theme-btn" aria-label="Switch color theme">
            <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" /></svg>
            <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" /></svg>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>
