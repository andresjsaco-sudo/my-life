<main id="main" class="wrap narrow">
  <a href="/projects" class="back-link"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12H5M11 6l-6 6 6 6"/></svg>All projects</a>
  <p class="crumbs">{{project.areaLabels}}</p>
  <h1 class="detail-title">{{project.title}}</h1>
  <p class="detail-meta">{{#if project.when}}{{project.when}} / {{/if}}{{project.context}}</p>

  {{#if project.specs}}
  <dl class="detail-specs">{{#each project.specs}}<div><dt>{{k}}</dt><dd>{{v}}</dd></div>{{/each}}</dl>
  {{/if}}

  <p class="detail-text">{{project.description}}</p>

  <p class="chips detail-chips">{{#each project.tech}}<span class="chip">{{#if icon}}{{icon icon}}{{/if}}{{label}}</span>{{/each}}</p>

  {{#if project.links.length}}
  <p class="detail-links">{{#each project.links}}<a href="{{url}}" target="_blank" rel="noopener noreferrer">{{label}}</a>{{/each}}</p>
  {{/if}}

  <nav class="case-nav" aria-label="More projects">
    <a href="{{prev.url}}"><span>Previous</span>{{prev.title}}</a>
    <a href="{{next.url}}" class="case-nav-next"><span>Next</span>{{next.title}}</a>
  </nav>
</main>
