<header class="topbar">
  <div class="wrap topbar-inner">
    <a href="#main" class="wordmark">Juan Andrés Betancourt</a>
    <nav aria-label="Main">
      <ul class="nav-links">
        <li><a href="#projects">Projects</a></li>
        <li><a href="#experience">Experience</a></li>
        <li><a href="#skills">Skills</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
    <button type="button" class="theme-btn" id="theme-btn" aria-label="Switch color theme">
      <span class="theme-btn-dot" aria-hidden="true"></span>
      <span class="theme-btn-text">Theme</span>
    </button>
  </div>
</header>

<main id="main">
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-head">
      <div class="hero-copy">
        <h1 id="hero-title">Embedded systems, IoT and cloud engineering.</h1>
        <p class="lede">
          I'm Juan Andrés, an electronic engineering student at Universidad del Norte in Barranquilla,
          Colombia. I work with ESP32 and Raspberry Pi firmware, wireless and cellular links, computer
          vision and serverless AWS backends.
        </p>
        <div class="hero-actions">
          <a href="#projects" class="btn btn-solid">See projects</a>
          <a href="mailto:{{contact.email}}" class="btn btn-line">Email me</a>
          <a href="{{github}}" class="btn btn-text" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
      <img src="/images/profile.jpg" alt="Portrait of Juan Andrés Betancourt" class="portrait" width="220" height="275" />
    </div>

    <div class="chain-block">
      <p class="chain-caption" id="chain-caption">Pick a stage to see the projects where I built it.</p>
      <ol class="chain" aria-describedby="chain-caption">
        {{#each stages}}
        <li class="chain-node">
          <button type="button" class="chain-btn" data-stage="{{key}}" aria-pressed="false">
            <span class="chain-pad" aria-hidden="true"></span>
            <span class="chain-name">{{name}}</span>
            <span class="chain-detail">{{detail}}</span>
          </button>
        </li>
        {{/each}}
      </ol>
    </div>

    <dl class="creds">
      {{#each credentials}}
      <div class="cred">
        <dt>{{term}}</dt>
        <dd>{{desc}}</dd>
      </div>
      {{/each}}
    </dl>
  </section>

  <section id="projects" class="section wrap" aria-labelledby="projects-title">
    <div class="section-head">
      <h2 id="projects-title">Projects</h2>
      <p class="filter-status" id="filter-status" aria-live="polite">
        <span id="filter-text">All {{projectCount}} projects</span>
        <button type="button" class="clear-btn" id="clear-filter" hidden>Show all</button>
      </p>
    </div>

    <ul class="projects">
      {{#each projects}}
      <li class="project{{#if featured}} project-featured{{/if}}" data-stages="{{stageList}}">
        <div class="project-meta">
          <p class="project-context">{{context}}</p>
          {{#if year}}<p class="project-year">{{year}}{{#if status}}, {{status}}{{/if}}</p>{{else}}{{#if status}}<p class="project-year">{{status}}</p>{{/if}}{{/if}}
          <div class="stage-marks" role="img" aria-label="Stages covered: {{stageNames}}">
            {{#each stageMarks}}<span class="mark{{#if on}} on{{/if}}" title="{{name}}"></span>{{/each}}
          </div>
        </div>
        <div class="project-body">
          <h3>{{title}}</h3>
          <p>{{description}}</p>
          <p class="project-stack">{{#each stack}}<span>{{this}}</span>{{/each}}</p>
          {{#if links.length}}
          <p class="project-links">
            {{#each links}}<a href="{{url}}" target="_blank" rel="noopener noreferrer">{{label}}</a>{{/each}}
          </p>
          {{/if}}
        </div>
      </li>
      {{/each}}
    </ul>
  </section>

  <section id="experience" class="section wrap" aria-labelledby="experience-title">
    <h2 id="experience-title">Experience</h2>
    <ol class="timeline">
      {{#each experience}}
      <li class="tl-item">
        <p class="tl-period">{{period}}</p>
        <div class="tl-body">
          <h3>{{title}}</h3>
          <p class="tl-org">{{org}}</p>
          {{#if progression}}<p class="tl-progression">{{progression}}</p>{{/if}}
          <p>{{desc}}</p>
        </div>
      </li>
      {{/each}}
    </ol>
  </section>

  <section id="skills" class="section wrap" aria-labelledby="skills-title">
    <h2 id="skills-title">Skills</h2>
    <dl class="skills">
      {{#each skills}}
      <div class="skill-row">
        <dt>{{group}}</dt>
        <dd>{{items}}</dd>
      </div>
      {{/each}}
      <div class="skill-row">
        <dt>Certifications</dt>
        <dd>{{#each certifications}}{{title}}, {{issuer}}{{/each}}</dd>
      </div>
    </dl>
  </section>

  <section id="contact" class="section contact" aria-labelledby="contact-title">
    <div class="wrap contact-inner">
      <div>
        <h2 id="contact-title">Let's talk</h2>
        <p class="contact-copy">
          I'm looking for full-time roles in embedded systems, IoT and cloud starting December 2026,
          in Barranquilla or remote.
        </p>
      </div>
      <ul class="contact-list">
        <li><a href="mailto:{{contact.email}}"><span>Email</span>{{contact.email}}</a></li>
        <li><a href="{{contact.linkedin}}" target="_blank" rel="noopener noreferrer"><span>LinkedIn</span>{{contact.linkedinHandle}}</a></li>
        <li><a href="{{github}}" target="_blank" rel="noopener noreferrer"><span>GitHub</span>{{githubHandle}}</a></li>
      </ul>
    </div>
  </section>
</main>

<footer class="footer wrap">
  <p>&copy; {{year}} {{name}}, {{location}}</p>
</footer>
