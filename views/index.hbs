<main id="main">
  <section class="hero2" aria-labelledby="hero-title">
    <div class="wrap hero2-inner">
      <div class="hero2-copy">
        {{> portrait cls="avatar avatar-lg" sizes="96px"}}
        <h1 id="hero-title">Juan Andrés Betancourt</h1>
        <p class="hero2-role">Electronic engineer, embedded systems, wireless links and cloud.</p>
        <p class="readout-line" data-lte-readout>
          Behind this page: my <a href="/projects/lte">LTE design</a> for south Bogotá, 78 real sites. Hover one.
          <span class="mono"><span data-field="site">eNB-42</span>, <span data-field="zone">UPZ 60 Parque Entrenubes, Usme</span>, <span data-field="nb" data-suffix=" within 900 m">6 within 900 m</span></span>
        </p>
      </div>
      <div class="hero2-map" data-lte-map>
        {{> ltemap}}
      </div>
    </div>
  </section>

  <div class="wrap home">
    <section class="intro" aria-label="About me">
      <div class="bio">
        {{#each bio}}<p>{{{this}}}</p>{{/each}}
      </div>
      <aside class="glance" aria-label="At a glance">
        <dl>
          {{#each glance}}<div><dt>{{k}}</dt><dd>{{v}}</dd></div>{{/each}}
        </dl>
        <div class="langs-row">{{#each languages}}<span class="lang">{{> flag code=code}}{{k}}</span>{{/each}}</div>
      </aside>
    </section>

    <section class="block" aria-labelledby="work-title">
      <div class="block-head"><h2 id="work-title">Selected work</h2><a href="/projects" class="more-link">All {{projectCount}} projects</a></div>
      <div class="pgrid pgrid-2">
        {{#each featured}}{{> projectcard}}{{/each}}
      </div>
    </section>

    <section class="block" aria-labelledby="skills-title">
      <div class="block-head"><h2 id="skills-title">Skills</h2><a href="/career" class="more-link">Career and education</a></div>
      <div class="marquee-wrap">
        {{#each skillRows}}
        <div class="marquee{{#if reverse}} marquee-rev{{/if}}">
          <p class="marquee-label">{{label}}</p>
          <div class="marquee-view">
            <ul class="marquee-track">
              {{#each items}}<li class="schip">{{#if icon}}{{icon icon "si"}}{{/if}}{{label}}</li>{{/each}}
              {{#each items}}<li class="schip" aria-hidden="true">{{#if icon}}{{icon icon "si"}}{{/if}}{{label}}</li>{{/each}}
            </ul>
          </div>
        </div>
        {{/each}}
      </div>
    </section>
  </div>
</main>
