<main id="main">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-map" data-lte-map>
      {{> ltemap}}
    </div>
    <div class="hero-fade" aria-hidden="true"></div>

    <div class="wrap hero-inner">
      <div class="hero-copy">
        <div class="hero-id">
          {{> portrait cls="avatar" sizes="72px"}}
          <div>
            <h1 id="hero-title">Juan Andrés Betancourt</h1>
            <p class="hero-role">Electronic engineer, embedded systems, wireless links and cloud.</p>
          </div>
        </div>
        <p class="status"><span class="status-item"><span class="status-dot" aria-hidden="true"></span>Available full time from December 2026</span><span>Barranquilla, CO, or remote</span></p>
      </div>
      <p class="readout-line" data-lte-readout>
        <span class="readout-label">Behind this text:</span> my <a href="/projects/lte">LTE design</a> for south Bogotá, 78 real sites. Hover one:
        <span class="mono"><span data-field="site">eNB-42</span>, <span data-field="zone">UPZ 60 Parque Entrenubes, Usme</span>, <span data-field="nb" data-suffix=" within 900 m">6 within 900 m</span></span>
      </p>
    </div>
  </section>

  <div class="wrap home">
    <section class="bio" aria-label="About me">
      {{#each bio}}<p>{{{this}}}</p>{{/each}}
      <p class="bio-links"><a href="/career">Career</a><a href="{{person.cv}}">CV (PDF)</a><a href="{{person.linkedin}}" target="_blank" rel="noopener noreferrer">LinkedIn</a><a href="{{person.github}}" target="_blank" rel="noopener noreferrer">GitHub</a></p>
    </section>

    <section class="block" aria-labelledby="work-title">
      <h2 id="work-title">Selected work</h2>
      <ul class="worklist">
        {{#each featured}}
        <li>
          <a href="{{url}}" class="work-title">{{title}}</a>
          <p>{{summary}}</p>
        </li>
        {{/each}}
      </ul>
      <a href="/projects" class="more-link">All {{projectCount}} projects</a>
    </section>

    <section class="block" aria-labelledby="skills-title">
      <h2 id="skills-title">Skills</h2>
      <dl class="skill-lines">
        {{#each skills}}<div><dt>{{k}}</dt><dd>{{v}}</dd></div>{{/each}}
        <div><dt>Languages</dt><dd>{{#each languages}}{{k}} ({{v}}){{#unless @last}}, {{/unless}}{{/each}}</dd></div>
      </dl>
    </section>
  </div>
</main>
