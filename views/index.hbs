<main id="main">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-map" data-lte-map>
      {{> ltemap}}
    </div>
    <div class="hero-fade" aria-hidden="true"></div>

    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="status"><span class="status-item"><span class="status-dot" aria-hidden="true"></span>Available full time, Dec 2026</span><span>Barranquilla, CO</span><span>Remote OK</span></p>
        <h1 id="hero-title">Juan Andrés<br />Betancourt</h1>
        <p class="hero-role">Electronic engineer working on embedded systems, wireless links and cloud.</p>
        <p class="hero-lede">Final year at Universidad del Norte. I write firmware for ESP32 and Raspberry Pi, plan cellular coverage, run computer vision at the edge and deploy serverless backends on AWS.</p>
        <div class="actions">
          <a href="#work" class="btn btn-solid">Selected work</a>
          <a href="mailto:{{person.email}}" class="btn btn-line">Get in touch</a>
        </div>
      </div>

      <div class="readout" data-lte-readout>
        <div class="readout-head"><span>LTE site readout</span><span class="readout-hint">hover a cell</span></div>
        <dl class="readout-body">
          <dt>site</dt><dd data-field="site">eNB-42</dd>
          <dt>zone</dt><dd data-field="zone">UPZ 60 Parque Entrenubes, Usme</dd>
          <dt>position</dt><dd data-field="pos">4.51945, -74.10069</dd>
          <dt>sectors</dt><dd>36°, 156°, 276°</dd>
          <dt>neighbors</dt><dd data-field="nb">6 within 900 m</dd>
        </dl>
      </div>
      <p class="readout-note">The background is my LTE design for San Cristóbal and Usme, Bogotá: {{lte.siteCount}} three-sector sites at their real coordinates. <a href="/projects/lte">Read the case study</a></p>
    </div>
  </section>

  <section class="facts" aria-label="Key facts">
    <dl class="wrap facts-grid">
      {{#each facts}}
      <div class="fact"><dt>{{k}}</dt><dd>{{v}}</dd></div>
      {{/each}}
    </dl>
  </section>

  <section id="work" class="wrap section" aria-labelledby="work-title">
    <div class="section-head">
      <h2 id="work-title">Selected work</h2>
      <a href="#projects" class="mono-link">All {{projectCount}} projects</a>
    </div>
    <div class="cards">
      {{#each featured}}
      <article class="card">
        <dl class="specs">
          {{#each specs}}<div class="spec"><dt>{{k}}</dt><dd>{{v}}</dd></div>{{/each}}
        </dl>
        <div class="card-body">
          <p class="card-meta">{{meta}}</p>
          <h3>{{title}}</h3>
          <p class="card-summary">{{summary}}</p>
          <div class="card-foot">
            {{#if caseStudy}}
            <a href="{{caseStudy}}" class="card-cta">Read the case study<svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8 H13 M9 4 L13 8 L9 12" /></svg></a>
            {{else}}
            <p class="card-links">{{#each links}}<a href="{{url}}" target="_blank" rel="noopener noreferrer">{{label}}</a>{{/each}}</p>
            {{/if}}
            <span class="card-tags">{{tags}}</span>
          </div>
        </div>
      </article>
      {{/each}}
    </div>
  </section>

  <section id="projects" class="wrap section" aria-labelledby="projects-title">
    <h2 id="projects-title" class="h-small">Also built</h2>
    <ul class="more">
      {{#each more}}
      <li>
        {{#if url}}<a href="{{url}}" target="_blank" rel="noopener noreferrer" class="more-title">{{title}}</a>{{else}}<span class="more-title">{{title}}</span>{{/if}}
        <span class="more-tag">{{tag}}</span>
      </li>
      {{/each}}
    </ul>
  </section>

  <section id="about" class="wrap section split" aria-labelledby="about-title">
    <h2 id="about-title" class="h-small">Experience</h2>
    <div class="split-body">
      {{#each experience}}
      <article class="exp">
        <p class="exp-period">{{period}}</p>
        <h3>{{title}}</h3>
        <p>{{desc}}</p>
      </article>
      {{/each}}
    </div>
  </section>

  <section id="skills" class="wrap section split" aria-labelledby="skills-title">
    <h2 id="skills-title" class="h-small">Skills</h2>
    <dl class="split-body skills">
      {{#each skills}}
      <div class="skill"><dt>{{k}}</dt><dd>{{v}}</dd></div>
      {{/each}}
    </dl>
  </section>

  <section id="contact" class="wrap section" aria-labelledby="contact-title">
    <div class="contact">
      <div class="contact-copy">
        <h2 id="contact-title">Let's talk.</h2>
        <p>Full-time roles in embedded systems, IoT, telecom and cloud, in Barranquilla or remote.</p>
      </div>
      <div class="actions">
        <a href="mailto:{{person.email}}" class="btn btn-solid">{{person.email}}</a>
        <a href="{{person.linkedin}}" class="btn btn-line" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="{{person.github}}" class="btn btn-line" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>
  </section>
</main>
