<main id="main" class="wrap">
  <section class="page-head" aria-labelledby="page-title">
    <p class="crumbs"><a href="/">Home</a><span aria-hidden="true">/</span>Projects</p>
    <h1 id="page-title">Projects</h1>
    <p class="case-lede">University, research and personal projects across embedded systems, radio, cloud, computer vision, control and analog design.</p>
  </section>

  <div class="filters" role="group" aria-label="Filter projects by area">
    <button type="button" class="filter-btn" data-filter="all" aria-pressed="true">All <span>{{projects.length}}</span></button>
    {{#each areas}}<button type="button" class="filter-btn" data-filter="{{key}}" aria-pressed="false">{{label}}</button>{{/each}}
  </div>
  <p class="filter-status" id="filter-status" aria-live="polite"></p>

  <ol class="plist">
    {{#each projects}}
    <li class="pitem" data-areas="{{areaList}}">
      <div class="pitem-meta">
        <span class="pitem-num">{{num}}</span>
        {{#if when}}<span>{{when}}</span>{{/if}}
        <span>{{context}}</span>
      </div>
      <div class="pitem-body">
        <h2>{{#if caseStudy}}<a href="{{caseStudy}}">{{title}}</a>{{else}}{{title}}{{/if}}</h2>
        {{#if specs}}<dl class="pitem-specs">{{#each specs}}<div><dt>{{k}}</dt><dd>{{v}}</dd></div>{{/each}}</dl>{{/if}}
        <p>{{description}}</p>
        <p class="pitem-stack">{{#each stack}}<span>{{this}}</span>{{/each}}</p>
        {{#if links.length}}<p class="pitem-links">{{#each links}}<a href="{{url}}"{{#unless (eq url "/projects/lte")}} target="_blank" rel="noopener noreferrer"{{/unless}}>{{label}}</a>{{/each}}</p>{{/if}}
      </div>
    </li>
    {{/each}}
  </ol>
</main>
