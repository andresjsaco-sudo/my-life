<main id="main" class="wrap">
  <section class="page-head" aria-labelledby="page-title">
    <h1 id="page-title">Projects</h1>
    <p class="page-lede">University, research and personal work. Pick one to see the details.</p>
  </section>

  <div class="filters" role="group" aria-label="Filter projects by area">
    <button type="button" class="filter-btn" data-filter="all" aria-pressed="true">All <span>{{projects.length}}</span></button>
    {{#each areas}}<button type="button" class="filter-btn" data-filter="{{key}}" aria-pressed="false">{{label}}</button>{{/each}}
  </div>
  <p class="filter-status" id="filter-status" aria-live="polite"></p>

  <div class="pgrid">
    {{#each projects}}<div class="pcell" data-areas="{{areaList}}">{{> projectcard}}</div>{{/each}}
  </div>
</main>
